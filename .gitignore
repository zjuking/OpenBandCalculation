# Paper directory — kept out of the GitHub sync.  The manuscript, reproduction
# scripts, figures and benchmark data live only in the local working tree (and
# are archived separately for the CPC submission via paper/cpc/make_submission.py).
paper/

# LaTeX build artefacts (paper/cpc/data/*.out are test logs -- keep those)
*.aux
*.bbl
*.blg
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# hyperref bookmarks, produced next to the .tex
paper/cpc/manuscript.out

# submission bundle (regenerate with paper/cpc/make_submission.py)
paper/cpc/dist/

# figure bitmaps are for local inspection; regenerate with --png
paper/cpc/figures/*.png
*.spl
